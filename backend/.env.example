# Backend server HTTP port
PORT=5003

# Cloudinary server-side document storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27018/sih_demo

# JWT signing secret
JWT_SECRET=replace-this-with-a-long-random-secret

# Mock department systems (used by `npm run demo`)
MOCK_EDU_PORT=4001
MOCK_EMP_PORT=4002

# Integration Engine HTTP behavior (optional)
ENGINE_HTTP_TIMEOUT_MS=10000
ENGINE_HTTP_MAX_RETRIES=2
ENGINE_HTTP_BASE_RETRY_DELAY_MS=500

# Consent Expiration Automation
CONSENT_EXPIRY_CHECK_INTERVAL_MS=60000

# Security & Rate Limiting
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_MAX=300
DOCUMENT_STORAGE=local0
RATE_LIMIT_VERIFY_MAX=60
RATE_LIMIT_GENERAL_MAX=500
