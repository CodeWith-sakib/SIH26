    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.1",
    "@types/xml2js": "^0.4.14",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
